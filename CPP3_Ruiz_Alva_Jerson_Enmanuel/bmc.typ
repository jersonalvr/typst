// bmc.typ
#import "../modules/biz_canvas.typ": biz_canvas

#biz_canvas(
  title: [= BMC Agro-IA Perú],
  business: "Agrotech con inteligencia artificial",
  problems: [
    *Problemas*
    - Baja tecnificación agrícola
    - Pérdidas por factores climáticos
    - Acceso limitado a asesoría técnica
  ],
  activities: [
    *Actividades Clave*
    - Desarrollo de modelos predictivos de IA
    - Recolección y análisis de datos satelitales
    - Capacitación y soporte en campo para agricultores
  ],
  metrics: [
    *Métricas*
    - Tasa de adopción de la tecnología por parte de agricultores
    - Reducción de pérdidas agrícolas
    - Net Promoter Score (NPS) de agricultores
  ],
  proposition: [
    *Propuesta de Valor*
    - Aumento de productividad en un 40%
    - Seguro agrícola integrado para protección financiera
    - Alertas meteorológicas personalizadas
