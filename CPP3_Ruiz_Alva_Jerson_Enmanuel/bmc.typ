  unfair: [
    *Ventajas Competitivas*
    - Algoritmos de IA adaptados a microclimas locales
    - Soporte en lenguas nativas como quechua y aymara
    - Modelo de negocio freemium accesible
  ],
  channels: [
    *Canales*
    - Aplicación móvil intuitiva
    - Cooperativas locales como canales de distribución
    - Participación en ferias agrícolas y eventos comunitarios
  ],
  clients: [
    *Segmentos de Clientes*
    - Pequeños agricultores en zonas rurales
    - Cooperativas agrícolas locales
    - Gobiernos locales interesados en desarrollo rural
  ],
  costs: [
    *Costos*
    - Desarrollo y mantenimiento de IA
    - Adquisición y distribución de sensores IoT
    - Programas de capacitación y soporte en campo
  ],
  revenues: [
    *Ingresos*
    - Suscripciones premium para acceso a funciones avanzadas
    - Comisiones por seguros agrícolas vendidos
    - Venta de datos agrícolas anonimizados para investigación
  ]
)